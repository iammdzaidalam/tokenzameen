# ---------------------------------------------------------------------------
# TokenZameen — environment
#
# Copy to `.env.local` for local work, or run `vercel env pull` once the Neon
# integration is attached. Every variable below is optional at build time:
# `src/lib/env.ts` never throws, and a missing DATABASE_URL degrades to a typed
# failure on submission rather than a broken build. See docs/DATA.md.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, pooled endpoint). Supplied by the Vercel
# integration as DATABASE_URL. Absent until provisioning is finished — with it
# unset, lead submissions fail honestly and are logged for manual recovery.
DATABASE_URL=

# Direct (non-pooled) endpoint. Only needed for `drizzle-kit push`/`studio`
# against a PgBouncer-fronted database. Neon supplies it as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=

# Salt for the one-way hash applied to visitor IPs before they are stored or
# used as a rate-limit key. Raw IPs are never persisted. Minimum 8 characters;
# generate with `openssl rand -hex 32`. If unset, each instance invents its own
# random salt, so stored hashes stop correlating across instances.
LEAD_HASH_SALT=

# In-memory rate limiter, per instance. Defaults: 60000 ms window, 8 requests.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Advisor contact details, read by src/content/config.ts (SITE). These are the
# fallback a buyer is shown when a submission cannot be recorded, so a blank
# value here means a failed enquiry has nowhere to go. Set all three.
NEXT_PUBLIC_ADVISOR_PHONE=
NEXT_PUBLIC_ADVISOR_WHATSAPP=
NEXT_PUBLIC_ADVISOR_EMAIL=

# Optional overrides for `pnpm db:seed`. Without an email the advisor record is
# skipped rather than invented.
SEED_ADVISOR_NAME=
SEED_ADVISOR_EMAIL=
SEED_ADVISOR_PHONE=

# Admin panel. See docs/ADMIN.md for the one-line commands that generate the
# hash and the secret. All three must be set for /admin to accept a login.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# AI property advisor. Without a key the advisor still answers from the
# catalogue deterministically; with one it adds streamed prose through the
# Vercel AI Gateway, grounded only in the projects it selected.
AI_GATEWAY_API_KEY=
AI_ADVISOR_MODEL=

# Interactive globe on the home page (Mapbox GL). A public token from
# https://account.mapbox.com — the free tier covers 50,000 loads a month. Without
# it the band renders the pins over the contour illustration instead.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Canonical origin for metadata, sitemap and structured data. Set to the
# production domain on Vercel; defaults to the deployment URL otherwise.
NEXT_PUBLIC_SITE_URL=
